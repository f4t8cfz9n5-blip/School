rules_version = '2';

// قواعد أولية: أي مستخدم مسجّل دخوله (الأخصائي الاجتماعي) يملك صلاحية كاملة.
// بما أن المنصة لمستخدم واحد فقط حاليًا، يمكن لاحقًا تقييدها بمعرّف
// المستخدم الفعلي (request.auth.uid == "UID_الأخصائي") لمزيد من التحصين.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
